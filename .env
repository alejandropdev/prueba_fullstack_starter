# Credenciales de DESARROLLO para la prueba técnica de Aravia.
# No son secretos reales, están quemadas a propósito y se dejan versionadas
# para que no tengas que copiar ni editar nada antes de arrancar.

# ---- Postgres (leído tanto por docker-compose como por la app Nest) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=aravia
DB_PASSWORD=aravia_dev_password
DB_NAME=aravia_prueba

# Cadena de conexión completa (conveniencia para psql / clientes gráficos, el código usa las variables de arriba)
DATABASE_URL=postgresql://aravia:aravia_dev_password@localhost:5432/aravia_prueba

# ---- App Nest ----
APP_PORT=3000
NODE_ENV=development

# ---- JWT (secreto de desarrollo, NO usar en producción) ----
JWT_SECRET=dev_only_secret_key_do_not_use_in_prod_2026
JWT_EXPIRES_IN=8h
